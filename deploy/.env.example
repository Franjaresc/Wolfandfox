# Optional for `docker compose up --build`, which has the same values as defaults.
# Local development needs a copy at deploy/.env, because the backend reads the database settings
# from it. deploy/.env is gitignored. These values are for local use only.
POSTGRES_DB=wolfandfox
POSTGRES_USER=wolfandfox
POSTGRES_PASSWORD=change-me-local-only
# The time zone that defines "today" for business rules, such as no closures in the future.
WOLFANDFOX_TIME_ZONE=UTC
# Host ports. They avoid clashing with other software on the host, such as an installed PostgreSQL.
POSTGRES_PORT=15432
BACKEND_PORT=8080
FRONTEND_PORT=8081
